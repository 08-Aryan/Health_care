# -----------------------------------
# Node.js / Express Backend Gitignore
# -----------------------------------

# Node modules
node_modules/

# Environment files (sensitive info)
.env
.env.local
.env.development
.env.production

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log
logs/
*.log

# OS files
.DS_Store
Thumbs.db

# Coverage output
coverage/

# Build artifacts
dist/
build/

# Optional cache folders
.cache/
.tmp/

# TypeScript (if added later)
*.tsbuildinfo

# VSCode settings
.vscode/
